{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floorflow.dev/schema/fevp-report-v1.schema.json",
  "title": "FloorPlan Editing Verification Protocol Report v1.0",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "protocol_version",
    "report_id",
    "method",
    "dataset",
    "task",
    "comparability",
    "edit_region",
    "scorer",
    "mandatory",
    "cases",
    "source_map"
  ],
  "properties": {
    "schema_version": {
      "const": "fevp-report-v1"
    },
    "protocol_version": {
      "const": "1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "comparability": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "matched",
            "context_only",
            "not_comparable"
          ]
        },
        "matched_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "edit_region": {
      "type": "object",
      "required": [
        "definition",
        "rasterization_rule",
        "valid_outside_rule"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "rasterization_rule": {
          "type": "string",
          "minLength": 1
        },
        "valid_outside_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scorer": {
      "type": "object",
      "required": [
        "implementation",
        "version",
        "code_commit"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "code_commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mandatory": {
      "type": "object",
      "required": [
        "outside_exact",
        "validity",
        "conditional_watertightness",
        "node_f1",
        "edge_overlap"
      ],
      "properties": {
        "outside_exact": {
          "allOf": [
            {
              "$ref": "#/$defs/coverageMetric"
            },
            {
              "type": "object",
              "properties": {
                "outside_pixel_exact": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "outside_room_label_exact": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              }
            }
          ]
        },
        "validity": {
          "$ref": "#/$defs/coverageMetric"
        },
        "conditional_watertightness": {
          "$ref": "#/$defs/coverageMetric"
        },
        "node_f1": {
          "$ref": "#/$defs/coverageMetric"
        },
        "edge_overlap": {
          "$ref": "#/$defs/coverageMetric"
        }
      }
    },
    "optional": {
      "type": "object",
      "properties": {
        "delta_iou": {
          "$ref": "#/$defs/coverageMetric"
        },
        "ged": {
          "$ref": "#/$defs/coverageMetric"
        },
        "delta_mse": {
          "$ref": "#/$defs/coverageMetric"
        }
      }
    },
    "cases": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "rows_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "excluded_components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "coverageMetric": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported_under_fevp",
            "reported_outside_fevp",
            "not_reported",
            "not_comparable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.0
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
