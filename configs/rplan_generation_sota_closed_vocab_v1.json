      "ADJACENCY": 1.5,
      "WALL": 1.5,
      "JUNCTION": 1.5,
      "OPENING": 1.5,
      "END": 2.0,
      "VERTEX": 0.75,
      "VD": 0.75
    },
    "stage_weights": {
      "envelope": 0.75,
      "program": 1.0,
      "rooms": 1.25,
      "walls": 1.35,
      "junctions": 1.5,
      "openings": 1.5,
      "furniture": 1.25,
      "validation": 1.5
    },
    "loss_balance": {
      "enabled": true,
      "reference": "polygon",
      "momentum": 0.95,
      "minimum_scale": 0.25,
      "maximum_scale": 1.5,
      "update_interval": 250,
      "diagnostics": true
    }
  },
  "screen_gates": {
    "finite_loss_and_gradients": true,
    "contract_assembly_required": true,
    "zero_oov_required": true,
    "no_silent_token_truncation": true,
    "dynamic_token_padding": true,
    "typed_graph_consistency": true,
    "token_conditioned_vector_refinement": true,
    "conflict_aware_backward": true,
    "token_consumer_validity_regression_gate": true,
    "target_length_generation_budget": true,
    "paired_vector_teacher_generated_contract": true,
    "exposure_shift_mitigation": true,
    "token_implied_soft_graph": true,
    "cached_token_length_index": true,
    "clean_validation_forward": true,
    "padding_safe_soft_graph": true,
    "probabilistic_or_adjacency": true,
    "paired_consumer_bootstrap_ci": true,
    "watertight_regression_gate": true,
    "kv_cache_constrained_generation": true,
    "entity_specific_refiner_gates": true,
    "token_to_discrete_graph_residual": true,
    "two_level_codetree_polygons": true,
    "verifier_guided_beam_reranking": true,
    "multi_step_rollout": true,
    "token_grpo_interface": true,
    "immutable_design_points": true,
    "space_syntax_reranking": true,
    "typed_state_bus": true,
    "room_instance_ids": true,
    "codetree_primary": true,
    "hungarian_room_assignment": true,
    "junction_face_candidate": true,
    "unified_verified_state_machine": true,
    "hierarchical_loss_objective": true,
    "test_split_opened": false,
    "architecture_gate_before_metrics": true
