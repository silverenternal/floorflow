{
  "scope": "residential_rplan_boundary_generation_with_typed_tokens",
  "test_split_policy": "closed",
  "candidate_status": "closed_vocabulary_pending_matched_retraining",
  "dataset": {
    "train": ".data/external/CE2EPlan/dataset/dataset_json/data_train.json",
    "validation": ".data/external/CE2EPlan/dataset/dataset_json/data_val.json"
  },
  "model": {
    "hidden_dim": 96,
    "decoder_channels": 96,
    "identity_queries": 12,
    "identity_layers": 2,
    "vector_layers": 2,
    "polygon_points": 24,
    "max_walls": 128,
    "max_openings": 8,
    "attention_heads": 4,
    "route_top_k": 16,
    "max_boundary_points": 64,
    "pretrained_backbone": false,
    "use_mask_anchors": true,
    "share_identity_heads": true,
    "enable_query_quality": false,
    "enable_point_validity": true,
    "use_boundary_edge_graph": true,
    "encoder_architecture": "resnet18",
    "compact_encoder_channels": [64, 128, 192, 288],
    "compact_encoder_blocks": [1, 3, 4, 2],
    "enable_program_set": false,
    "enable_query_graph_refiner": true,
    "enable_token_head": true,
    "token_vocab_size": 412,
    "token_max_length": 512,
    "token_head_layers": 2,
    "token_refine_scale": 0.02,
    "token_refiner_min_confidence": 0.05,
    "enable_token_graph_head": true,
    "token_graph_residual_scale": 0.5,
    "token_graph_max_junctions": 32,
    "token_graph_degree_classes": 9,
    "enable_codetree_head": true,
    "codetree_primary": true,
    "topology_faces_primary": true
  },
  "tensors": {
    "image_size": 128,
    "canvas_size": 256,
    "max_boundary_points": 64,
    "max_rooms": 12,
    "room_points": 24,
    "max_walls": 128,
    "max_openings": 8
  },
  "training": {
    "epochs": 8,
    "train_cases": 256,
    "validation_cases": 64,
    "batch_size": 2,
    "learning_rate": 0.0002,
    "token_learning_rate_multiplier": 2.0,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "workers": 4,
    "seed": 2905,
    "device": "cuda:0"
  },
  "runtime": {
    "precision": "bf16",
    "tf32": true,
    "triton_kernels": true,
    "compile_model": false,
    "compile_mode": "default",
    "channels_last": false,
    "persistent_workers": true,
    "prefetch_factor": 4
  },
  "loss_weights": {
    "polygon": 1.0,
    "identity": 1.0,
    "count": 0.5,
    "wall": 0.5,
    "opening": 0.25,
    "adjacency": 0.25,
    "query_separation": 0.1,
    "class_balance_power": 0.0,
    "class_aware_separation": false,
    "supervised_separation": false,
    "query_quality": 0.0,
    "point_validity": 0.5,
    "room_program": 0.0,
    "token": 0.15,
    "token_structure": 0.1
  },
  "tokenization": {
    "enabled": true,
    "vocabulary_path": "outputs/token_vocabulary/rplan_fulltrain_closed_v1/vocabulary.json",
    "max_length": 512,
    "numeric_bin_size": 8,
    "geometry_token_mode": "reference",
    "zero_oov": true,
    "bucket_by_length": true,
    "generation_eval_samples": 8,
    "generation_max_new_tokens": 512,
    "generation_budget_multiplier": 1.25,
    "generation_efficiency_budget": 64,
    "hard_validity_regression_gate": true,
    "beam_width": 4,
    "space_syntax_rerank": true,
    "hierarchy_weights": {
      "primary": 1.0,
      "topology": 0.5,
      "sequence": 0.2
    },
    "verifier_policy_weight": 0.02,
    "verifier_reward_baseline": 0.0,
    "verifier_reward_replay": {
      "refresh_interval": 20,
      "max_age_steps": 200,
      "workers": 1
    },
    "conflict_projection": true,
    "conflict_interval": 5,
    "conflict_parameter_scope": "token_heads",
    "balance_parameter_scope": "token_heads",
    "conflict_pairs": [
      ["token_structure", "wall"],
      ["token_structure", "opening"]
    ],
    "warmup_steps": 100,
    "structure_start_step": 100,
    "structure_ramp_steps": 100,
    "scheduled_sampling_start": 100,
    "scheduled_sampling_ramp": 100,
    "token_dropout_prob": 0.1,
    "prefix_corruption_prob": 0.1,
    "token_rollout_steps": 1,
    "weight": 0.15,
    "structure_weight": 0.1,
    "kind_weights": {
