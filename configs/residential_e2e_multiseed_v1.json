{
  "schema_version": "residential-e2e-multiseed-config-v1",
  "scope": "residential_floorplan_only",
  "seeds": [19, 20, 21, 22, 23],
  "test_access": "forbidden_until_validation_freeze",
  "inputs": {
    "predicted_refiner": "outputs/reports/residential_predicted_refiner_*_v1.json",
    "cagn_multiseed": "outputs/reports/residential_cagn_multiseed_v1.json",
    "interaction": "outputs/reports/residential_interaction_policy_*_v1.json",
    "graph_rows": "outputs/reports/residential_graph_refinement_exact_rows_v1.json",
    "external_rows": "outputs/reports/residential_external_comparison_rows_v1.json",
    "predicted_edit": "outputs/reports/residential_predicted_edit_v1.json",
    "runtime": "outputs/reports/residential_e2e_runtime_benchmark_v1.json"
  },
  "statistics": {
    "seed_interval": "student_t_95",
    "paired_test": "wilcoxon",
    "effect_size": "rank_biserial",
    "multiplicity": "holm_bonferroni",
    "alpha": 0.05
  },
  "primary_endpoints": [
    "graph_node_f1",
    "graph_edge_overlap",
    "graph_ged",
    "external_room_iou",
    "external_node_f1",
    "external_edge_overlap",
    "external_ged"
  ],
  "claim_policy": {
    "interaction_must_be_stable_to_be_promoted": true,
    "hard_guards_must_hold_every_seed": true
  }
}
