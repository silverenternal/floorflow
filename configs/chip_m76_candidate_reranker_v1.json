  "validation": {
    "protocol": "8_fold_grouped_case_out",
    "epochs_per_fold": 200,
    "epochs_final": 200,
    "seed": 76,
    "device": "cpu"
  },
  "gate": {
    "cost_relative_high": 0.0,
    "v_rel_relative_high": 0.0,
    "area_gap_relative_high": 0.0,
    "b2b_hpwl_gap_relative_high": 0.0,
    "feasibility_one": true
  },
  "claim_boundary": "Frozen development evidence only. Official-100 cannot enter model fitting or epoch selection."
}
