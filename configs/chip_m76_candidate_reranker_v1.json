{
  "version": "chip-m76-candidate-reranker-v1",
  "date": "2026-11-01",
  "status": "ready",
  "training_cases": 32,
  "candidate_sources": {
    "m48_inference_seeds": [19, 20, 21],
    "deterministic": ["M61B", "M65"]
  },
  "variants": ["baseline", "expanded", "projector32"],
  "candidates_per_case": 15,
  "features": [
    "v_rel_rank",
    "displacement_rank",
    "boundary_rank",
    "grouping_rank",
    "b2b_hpwl_rank",
    "p2b_hpwl_rank",
    "compactness_rank",
    "aspect_rank",
    "rung_rank",
    "solves_rank"
  ],
  "forbidden_inference_inputs": [
    "target_boxes",
    "official_cost",
    "v_rel_label",
    "trinity_outcomes",
    "case_identity"
  ],
  "model": {
    "hidden": 16,
    "layers": 2,
    "activation": "silu",
    "normalization": "layernorm"
  },
  "loss": {
    "type": "listwise_cross_entropy",
    "temperature": 0.05
  },
  "optimizer": {
    "name": "adamw",
    "learning_rate": 0.01,
    "weight_decay": 0.001
