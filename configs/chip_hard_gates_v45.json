    "screen_cases": 32,
    "screen_salt": "chip-hard-gates-v45",
    "screen_manifest": "outputs/reports/chip_dev_screen_v45.json"
  },
  "official": {
    "cache": "outputs/cache/chip_official_test_100_v1",
    "cases": 100
  },
  "candidate_checkpoints": {
    "19": "outputs/chip_hierarchy/v7_bbox_anneal_20k/typed_hierarchy_bbox_anneal_seed19_20k/checkpoints/final.pt",
    "20": "outputs/chip_hierarchy/v10_three_seed/typed_hierarchy_seed20_20k/checkpoints/final.pt",
    "21": "outputs/chip_hierarchy/v10_three_seed/typed_hierarchy_seed21_20k/checkpoints/final.pt"
