  },
  "baseline_evidence": [
    "outputs/reports/chip_refiner_official_1600_three_seed_v44.json",
    "outputs/reports/chip_matched_budget_1600_detglop_seed19_v44.json",
    "outputs/reports/chip_external_ppa_holdout_v44_all.json",
    "outputs/reports/chip_p2b_routing_rootcause_v44_holdout18.json",
    "outputs/reports/chip_final_sota_gate_v44.json"
  ],
  "matched_compute_gate": {
    "metrics": ["legalized_hard_cost", "legalized_v_rel"],
    "direction": "lower_is_better",
    "screen_requirement": "candidate_strictly_better_on_both",
    "official_requirement": "candidate_strictly_better_on_both_for_all_three_seeds",
    "pooled_interval_requirement": "paired_ci_upper_below_zero",
