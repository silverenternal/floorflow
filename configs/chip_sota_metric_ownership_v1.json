    "S5-CERTIFY": "S2-CLOSEST-METRIC-GATE"
  },
  "task_registry": "chipstodo.json",
  "proxy_real_protocol": {
    "default_state": "diagnostic_only",
    "evaluation_unit": "candidate within case",
    "bootstrap": {
      "iterations": 5000,
      "unit": "case",
      "same_case_pairs": true,
      "seed": 20261101
    },
    "measurements": [
      "spearman_rho",
      "case_block_95_ci",
      "pairwise_sign_agreement",
      "top3_true_best_recall",
      "selected_regret_median",
      "selected_regret_p95",
      "calibration_slope",
      "calibration_intercept",
      "complexity_stratum_sign_reversal"
    ],
    "screen_eligible": {
      "minimum_cases": 15,
      "minimum_candidates_per_case": 4,
      "spearman_rho_min": 0.60,
      "pairwise_sign_agreement_min": 0.75,
      "top3_true_best_recall_min": 0.80,
      "no_high_complexity_sign_reversal": true
    },
    "promotion_eligible": {
      "minimum_cases": 64,
      "spearman_rho_min": 0.75,
      "lower_95_ci_min": 0.50,
      "pairwise_sign_agreement_min": 0.85,
      "top3_true_best_recall_min": 0.90,
      "selected_regret_p95_max": 0.05,
      "no_stratum_sign_reversal": true
    },
    "hard_rules": [
      "A proxy that fails screen_eligible may be logged but cannot choose a checkpoint, arm, candidate or claim.",
      "A target-conditioned training surrogate is marked train_only and cannot appear in deployment selection.",
      "No candidate variance within a case is reported as no discrimination, not zero error.",
      "Every proxy-real audit uses the same case list, legalizer policy, scorer and budget as the real metric.",
      "External surrogate metrics never replace routed wirelength, congestion, DRC, power or timing.",
      "High-complexity 81-120-block cases are a mandatory consistency stratum."
    ],
    "atm_protocol": {
      "purpose": "Evaluate every atom independently before end-to-end screening.",
      "checks": [
        "parameter and gradient reachability",
        "gate-open fraction when a gate exists",
        "shuffle or zero-input sensitivity",
        "controlled ablation delta",
        "representation reconstruction or relation probe",
        "downstream metric ownership and proxy-real consistency"
      ],
      "disabled_atom_rule": "An opt-in atom reports not_applicable when disabled; enabling it requires the same checks on a synthetic and real batch."
    }
  },
