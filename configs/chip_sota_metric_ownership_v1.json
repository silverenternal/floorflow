{
  "version": "chip-sota-metric-ownership-v1",
  "date": "2026-11-01",
  "objective": "Assign every SOTA gap and every trainable chip-model atom an explicit proxy metric, real metric, consistency gate, owner task and rejection rule.",
  "evidence_boundary": "This register is a preregistered evaluation plan. It contains no new quality evidence.",
  "task_alias_map": {
    "S0-METRIC-ARCH-CLOSURE": "S1-ATOM-ISOLATED-TRAINING",
    "S1-GROUP-STATE": "S1-ATOM-ISOLATED-TRAINING",
    "S2-LEGAL-ENDPOINT": "S2-CLOSEST-METRIC-GATE",
    "S3A-ATOM-GENERATORS": "S3-COVERAGE-AND-TAIL",
    "S3-CONSENSUS": "S5-BUDGET-CERTIFY",
