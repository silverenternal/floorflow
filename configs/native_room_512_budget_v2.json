    "screen_type_accuracy_delta_min": 0.0,
    "screen_count_mae_delta_max": 0.0,
    "reasonableness_validity": 1.0,
    "functional_watertight_min": 0.95,
    "wall_continuity_min": 0.95,
    "plan_plausibility_min": 0.95
  }
